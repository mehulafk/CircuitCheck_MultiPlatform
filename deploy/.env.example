CIRCUITCHECK_DOMAIN=review.example.com
CIRCUITCHECK_AUTH_USER=admin
# Use: docker run --rm -it caddy:2-alpine caddy hash-password
# Single quotes preserve the literal dollar signs in a Compose .env file.
CIRCUITCHECK_AUTH_HASH=''
CIRCUITCHECK_IMAGE=ghcr.io/mehulafk/circuitcheck_multiplatform:main
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
